<?xml version="1.0" encoding="utf-8"?>
<!-- See backup_rules.xml. Nothing RelayDisplay stores is meaningful on another device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/" />
        <exclude domain="file" path="relay_cache/" />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/" />
        <exclude domain="file" path="relay_cache/" />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
